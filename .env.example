TAVILY_API_KEY=tvly-...

# Any provider supported by langchain's init_chat_model. Pick ONE block.

# Groq (free tier: create a key at console.groq.com)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=gsk_...

# Claude (paid API)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5      # or claude-sonnet-5-5: half the price, faster
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_EFFORT=medium             # low | medium | high - deeper thinking costs more tokens
# CLAUDE_FALLBACKS=1             # 0 = no automatic rerun on a fallback model when a request is declined

# OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5-mini
# OPENAI_API_KEY=sk-...

# Local, free, slow (15+ min per roadmap on a 4GB GPU)
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:3b
# OLLAMA_NUM_CTX=4096
# OLLAMA_NUM_PREDICT=2048   # caps runaway answers from small models

# Milestones whose tasks are written up front; the rest are written as you get close to them
WRITE_AHEAD_MILESTONES=1

# Google Calendar (optional): schedule quests around your real week. GLAI reads free/busy only.
# Google Cloud Console -> APIs & Services: enable "Google Calendar API"; OAuth consent screen: add yourself
# as a test user; Credentials -> Create OAuth client ID -> type "Desktop app". Then connect from the app.
# GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
